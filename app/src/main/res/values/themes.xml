<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown by the Android system splash. Same colour as the first animation frame and an
         empty icon, so the system splash hands over to the Hologram Reveal without a visible jump. -->
    <style name="Theme.Nexa.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nexa_space</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/nexa_splash_empty</item>
        <item name="postSplashScreenTheme">@style/Theme.Nexa</item>
    </style>

    <style name="Theme.Nexa" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nexa_space</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorBackground">@color/nexa_space</item>
    </style>
</resources>
